diff --git a/internal/extractors/tsextractor/configwalk.go b/internal/extractors/tsextractor/configwalk.go
index 35339bb..56a89d0 100644
--- a/internal/extractors/tsextractor/configwalk.go
+++ b/internal/extractors/tsextractor/configwalk.go
@@ -114,9 +114,13 @@ func (w *tsAliasWalk) walk(ctx context.Context, dir string) {
 // walkDirDescendsInto reports whether filepath.WalkDir would descend into root.
 // It is the one place the two enumerations genuinely disagree: WalkDir lstats
 // its root and stops at a symlink, while overlayReadDir follows one, so a
-// symlinked repository root would gain config candidates it has never had. The
-// lstat is the same one filepath.WalkDir performs before any scope check, so
-// asking here observes nothing the walk did not already observe.
+// symlinked repository root would gain config candidates it has never had.
+//
+// The lstat is an addition, not a reuse. filepath.WalkDir performs its own and
+// cannot be handed this one, so the declining path pays two; the fused path
+// pays this one alone, with no walk to share it with. Operation accounting for
+// this enumeration must include one added lstat per tsConfigInputs call.
+// Against it stands one fewer listing of every directory in the tree.
 func walkDirDescendsInto(root string) bool {
 	info, err := os.Lstat(root) //factpath:host
 	return err == nil && info.IsDir()
