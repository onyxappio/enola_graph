+// TestConfigEnumerationProductionInputsRootReview covers the path production
+// actually takes. Every production caller of tsConfigInputs runs without a
+// probe -- the only non-test withOverlayProbe attach point is newDiscovery,
+// whose context never reaches here -- and the fused enumeration is declined
+// while a probe is present, so the oracle above characterizes the fallback.
+//
+// This asserts the returned candidate set on the same fixtures with no probe
+// attached. That reaches the fused enumeration only where the call is eligible
+// for it: the symlinked-root, unreadable-directory and policy-refused fixtures
+// decline for their own reasons and exercise the fallback here too, which is
+// the point of keeping them. It reuses each golden's Inputs rather than a
+// second expectation, so both paths answer to one baseline.
+func TestConfigEnumerationProductionInputsRootReview(t *testing.T) {
+	for _, f := range configEnumFixtures {
+		t.Run(f.name, func(t *testing.T) {
+			repo, scope, _ := f.build(t)
+			got := tsConfigInputs(context.Background(), repo, scope)
+			body, err := os.ReadFile(filepath.Join(configEnumGoldenDir, f.name+".json"))
+			if err != nil {
+				t.Fatalf("golden missing; regenerate against unmodified source: %v", err)
+			}
+			var want oracleCapture
+			if err := json.Unmarshal(body, &want); err != nil {
+				t.Fatal(err)
+			}
+			a, _ := json.Marshal(got)
+			b, _ := json.Marshal(want.Inputs)
+			if string(a) != string(b) {
+				t.Fatalf("production inputs differ\n--- want ---\n%s\n--- got ---\n%s", b, a)
+			}
+		})
+	}
