+// TestTransactionRefusesARewrittenStateWithoutPublishing takes the same-length
+// rewrite through a whole transaction rather than through materializeDeferred
+// directly, because the thing that matters is not only that the check fires: it
+// is that nothing is published, no generation moves and the retry that follows
+// behaves.
+func TestTransactionRefusesARewrittenStateWithoutPublishing(t *testing.T) {
+	eng, root, dir, st := predicateFixture(t)
+	sink := &graphstream.MemorySink{}
+	r, err := openSession(context.Background(), eng, root, sink, summaryOpts(dir))
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	t.Cleanup(func() { _ = r.Close() })
+	if r.deferred == nil || r.deferred.bytes == nil {
+		t.Fatal("the open did not defer with its bytes retained")
+	}
+	if err := os.WriteFile(filepath.Join(root, "src/leaf.ts"),
+		[]byte("import {base} from './base';\nexport const leaf=base+4;\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	original := stateBytes(t, dir)
+	editInPlaceSameLength(t, dir)
+	rewritten := stateBytes(t, dir)
+
+	res, _, err := r.transaction(context.Background(), nil, false)
+	if !errors.Is(err, ErrInputsChanged) {
+		t.Fatalf("transaction over a rewritten state: err = %v, res = %+v, want ErrInputsChanged", err, res)
+	}
+	if len(sink.CloneRecords()) != 0 {
+		t.Fatalf("the refused transaction published %d records", len(sink.CloneRecords()))
+	}
+	// The generation on disk is the one the rewriter left, unmoved by this run:
+	// a refused transaction commits nothing.
+	after, _, err := readStateFileFP(statePath(dir), &stateReadWork{})
+	if err != nil {
+		t.Fatalf("the rewritten state does not decode, so this test proved the decoder caught it rather than the check: %v", err)
+	}
+	if after.Generation != st.Generation {
+		t.Fatalf("generation moved %d -> %d behind a refused transaction", st.Generation, after.Generation)
+	}
+	if !bytes.Equal(stateBytes(t, dir), rewritten) {
+		t.Fatal("the refused transaction wrote to the state file")
+	}
+	// And the failure did not leave the resident holding the state it could not
+	// use, on a deferral a later transaction would meet.
+	if r.deferred != nil && r.deferred.bytes != nil {
+		t.Fatal("the failed transaction kept its stale buffer")
+	}
+
+	// Put the bytes back and the same resident has to go on and do the work. A
+	// refusal that left it permanently unable to resolve its deferral would be a
+	// worse failure than the one it was protecting against.
+	if err := os.WriteFile(statePath(dir), original, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	res, work, err := r.transaction(context.Background(), nil, false)
+	if err != nil {
+		t.Fatalf("retry after the state was restored: %v", err)
+	}
+	if work.ProofRefusal == "" {
+		t.Fatal("the edited tree was admitted on the retry")
+	}
+	if work.StateDecodes != 1 {
+		t.Fatalf("retry decodes = %d, want 1", work.StateDecodes)
+	}
+	if res.ParsedFiles == 0 {
+		t.Fatalf("the retry parsed nothing after the edit: %+v", res)
