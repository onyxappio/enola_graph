+// TestCloseBeforeAnyTransactionReleasesTheRetainedState covers the resident that
+// is opened and dropped. Nothing will decode those bytes, and until Close there
+// is no other moment that says so.
+func TestCloseBeforeAnyTransactionReleasesTheRetainedState(t *testing.T) {
+	eng, root, dir, _ := predicateFixture(t)
+	r := deferredSession(t, eng, root, dir)
+	if err := r.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if r.deferred == nil || r.deferred.bytes != nil {
+		t.Fatal("Close left the committed state held")
+	}
+}
+
+// TestRefusedDeferralDigestsTheStateOnce is the reason for the change, stated as
+// a count rather than as a duration.
+//
+// The refused path used to read and digest the committed state at the open and
+// then read and digest it again to decide whether it had moved. It now reads it
+// again and compares. The read is still there - this is not a claim that the
+// second read went away - and the digest is not.
+func TestRefusedDeferralDigestsTheStateOnce(t *testing.T) {
+	eng, root, dir, _ := predicateFixture(t)
+	if err := os.WriteFile(filepath.Join(root, "src/leaf.ts"),
+		[]byte("import {base} from './base';\nexport const leaf=base+3;\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// The open is inside the capture, not before it. The claim is about what one
+	// session does to the committed state from end to end - the open reads and
+	// digests it, the refusal reads it again - and a trace that starts after the
+	// open can only see half of that.
+	var work WorkCounters
+	var terr error
+	trace := captureProfile(t, func() {
+		r, err := openSession(context.Background(), eng, root, &graphstream.MemorySink{}, summaryOpts(dir))
+		if err != nil {
+			terr = err
+			return
+		}
+		defer func() { _ = r.Close() }()
+		if r.deferred == nil || r.deferred.bytes == nil {
+			terr = errors.New("the open did not defer with its bytes retained")
+			return
+		}
+		_, work, terr = r.transaction(context.Background(), nil, false)
+	})
+	if terr != nil {
+		t.Fatalf("refused transaction: %v", terr)
+	}
+	if work.ProofRefusal == "" {
+		t.Fatal("an edited tree was admitted")
+	}
+	// state_fingerprint is logged by the read side and by the commit's write
+	// side, and only the read side is what changed here, so the two are counted
+	// apart rather than together. The write mark carries "write" in its tail;
+	// that is the whole difference between them in the trace.
+	marks := func(name string, want func(string) bool) int {
+		n := 0
+		for _, line := range strings.Split(trace, "\n") {
+			if strings.Contains(line, name) && (want == nil || want(line)) {
+				n++
+			}
+		}
+		return n
+	}
+	read := func(line string) bool { return !strings.Contains(line, "write") }
+	write := func(line string) bool { return strings.Contains(line, "write") }
+	defer func() {
+		if t.Failed() {
+			t.Logf("trace:\n%s", trace)
+		}
+	}()
+
+	// One digest over the committed state, where there used to be two.
+	if work.StateFingerprints != 1 {
+		t.Fatalf("a refused deferral digested the committed state %d times, want 1", work.StateFingerprints)
+	}
+	if n := marks("state_fingerprint", read); n != 1 {
+		t.Fatalf("read-side state_fingerprint marks = %d, want 1: the duplicate digest is back", n)
+	}
+	// The write side is unchanged and is named so that it is accounted for
+	// rather than quietly excluded: this run publishes, and what it publishes it
+	// digests once on the way out.
+	if n := marks("state_fingerprint", write); n != 1 {
+		t.Fatalf("write-side state_fingerprint marks = %d, want the committing run's one", n)
+	}
+	// What replaced the second read-side digest, and what did not: the file is
+	// still read twice.
+	if n := marks("state_bytes_compared", nil); n != 1 {
+		t.Fatalf("state_bytes_compared marks = %d, want 1", n)
+	}
+	if n := marks("state_read_bytes", func(l string) bool { return strings.Contains(l, "state.json") }); n != 2 {
+		t.Fatalf("state_read_bytes marks over state.json = %d, want 2: option C removes the hash, not the read", n)
+	}
+	// And the decode the deferral existed to skip happens exactly once, on the
+	// retained bytes.
+	if n := marks("state_json_unmarshal", nil); n != 1 {
+		t.Fatalf("state_json_unmarshal marks = %d, want 1", n)
+	}
+	if work.StateDecodes != 1 {
+		t.Fatalf("decodes = %d, want 1", work.StateDecodes)
+	}
+}
