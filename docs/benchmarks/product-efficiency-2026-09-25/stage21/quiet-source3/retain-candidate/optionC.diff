+// TestRecheckCommittedDoesNotTouchTheRetainedBuffer is about the helper's
+// handling of the caller's buffer, and nothing more.
+//
+// It does not establish reachability or reclamation. Whether the comparison
+// buffer is actually freed, and what the peak is while both readings are live,
+// is an RSS observation on a measured run; a unit test asserting it would be
+// asserting the collector's schedule. What is checked here is what can be:
+// the retained buffer comes back exactly as it went in, and a difference is
+// reported as a difference.
+func TestRecheckCommittedDoesNotTouchTheRetainedBuffer(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "state.json")
+	payload := bytes.Repeat([]byte("abcdefgh"), 1024)
+	if err := os.WriteFile(path, payload, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	retained := append([]byte(nil), payload...)
+
+	found, err := recheckCommitted(path, retained)
+	if err != nil || found != committedSame {
+		t.Fatalf("recheck of an unchanged file = %v, %v", found, err)
+	}
+	// The comparison reads the caller's buffer; one that reused it as scratch
+	// would corrupt the thing about to be decoded.
+	if !bytes.Equal(retained, payload) {
+		t.Fatal("the comparison modified the retained buffer")
+	}
+
+	if found, err := recheckCommitted(path, retained[:len(retained)-1]); err != nil || found != committedRewritten {
+		t.Fatalf("recheck against a shorter retained buffer = %v, %v", found, err)
+	}
+	if found, err := recheckCommitted(filepath.Join(dir, "absent.json"), retained); err != nil || found != committedRemoved {
+		t.Fatalf("recheck of an absent file = %v, %v", found, err)
+	}
+}
