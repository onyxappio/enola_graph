+package graphsession
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/enola-labs/enola/internal/engine"
+	"github.com/enola-labs/enola/internal/graphstream"
+)
+
+// The deferral holds the committed state it did not decode, and decides whether
+// the file still holds those bytes by comparing against them rather than by
+// digesting the file a second time. These are the cases where that comparison
+// has to answer the same way the fingerprint comparison it replaced did.
+//
+// A rewrite between the proof and the decode is the condition the check exists
+// for. It is not a race the lock covers - the lock excludes another session, not
+// another process - so every shape of it is stated here: the same bytes edited
+// in place with the timestamps put back, a wholesale replacement, a removal and
+// a truncation. The first is the one a cheaper check would miss, and the reason
+// the bytes are retained at all.
+
+// deferredSession opens a summary session over an unchanged committed
+// generation and returns it with the deferral in place, having established that
+// the open really did defer and really is holding the bytes.
+func deferredSession(t *testing.T, eng *engine.Engine, root, dir string) *Resident {
+	t.Helper()
+	r, err := openSession(context.Background(), eng, root, &graphstream.MemorySink{}, summaryOpts(dir))
+	if err != nil {
+		t.Fatalf("open summary session: %v", err)
+	}
+	t.Cleanup(func() { _ = r.Close() })
+	if r.deferred == nil {
+		t.Fatal("the summary open decoded the committed state instead of deferring it")
+	}
+	if r.deferred.bytes == nil {
+		t.Fatal("the deferral kept no bytes, so nothing can be compared against them")
+	}
+	if !bytes.Equal(r.deferred.bytes, stateBytes(t, dir)) {
+		t.Fatal("the retained bytes are not the bytes on disk")
+	}
+	// The accounting copy must not be a second reference to the same 54MB the
+	// deferral is holding: openSeek outlives the deferral.
+	if r.openSeek.retained != nil {
+		t.Fatal("openSeek kept its own reference to the committed state")
+	}
+	return r
+}
+
+var hexDigest = regexp.MustCompile(`[0-9a-f]{64}`)
+
+// editInPlaceSameLength changes one byte of the committed state without
+// changing its length, its validity or its timestamps.
+//
+// The edited byte is inside a hex digest, so the file still parses and still
+// decodes: a test that corrupted the JSON would be caught by the decoder and
+// would say nothing about the check in front of it. Size and mtime are what they
+// were, which is what makes this the case a stat comparison cannot see.
+func editInPlaceSameLength(t *testing.T, dir string) {
+	t.Helper()
+	path := statePath(dir)
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b := stateBytes(t, dir)
+	loc := hexDigest.FindIndex(b)
+	if loc == nil {
+		t.Fatal("no digest in the committed state to edit")
+	}
+	edited := append([]byte(nil), b...)
+	if edited[loc[0]] == '0' {
+		edited[loc[0]] = '1'
+	} else {
+		edited[loc[0]] = '0'
+	}
+	if len(edited) != len(b) {
+		t.Fatal("the in-place edit changed the length")
+	}
+	if err := os.WriteFile(path, edited, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(path, info.ModTime(), info.ModTime()); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if after.Size() != info.Size() || !after.ModTime().Equal(info.ModTime()) {
+		t.Fatalf("the rewrite is visible in the metadata: size %d->%d mtime %v->%v",
+			info.Size(), after.Size(), info.ModTime(), after.ModTime())
+	}
+}
+
+func TestDeferredDecodeRefusesEveryShapeOfRewrite(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		want   string
+		break_ func(t *testing.T, dir string)
+	}{
+		{"same length in place, timestamps restored", "rewritten", editInPlaceSameLength},
+		{"replaced with a different state", "rewritten", func(t *testing.T, dir string) {
+			if err := os.WriteFile(statePath(dir), []byte(`{"Generation":1}`), 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{"truncated", "rewritten", func(t *testing.T, dir string) {
+			b := stateBytes(t, dir)
+			if err := os.WriteFile(statePath(dir), b[:len(b)/2], 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{"removed", "removed", func(t *testing.T, dir string) {
+			if err := os.Remove(statePath(dir)); err != nil {
+				t.Fatal(err)
+			}
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			eng, root, dir, _ := predicateFixture(t)
+			r := deferredSession(t, eng, root, dir)
+			tc.break_(t, dir)
+
+			err := r.materializeDeferred(&WorkCounters{})
+			if err == nil {
+				t.Fatal("a state that moved under its proof was decoded anyway")
+			}
+			if !errors.Is(err, ErrInputsChanged) {
+				t.Fatalf("error = %v, want ErrInputsChanged", err)
+			}
+			if !bytes.Contains([]byte(err.Error()), []byte(tc.want)) {
+				t.Fatalf("error = %q, want it to say %q", err, tc.want)
+			}
+			if r.state != nil {
+				t.Fatal("the refused decode installed a state")
+			}
+			// The retained buffer is stale the moment the file stops matching it,
+			// and a deferral that keeps it is holding the whole committed state
+			// for a retry that must not use it.
+			if r.deferred == nil || r.deferred.bytes != nil {
+				t.Fatalf("failure left deferred=%v with bytes retained", r.deferred != nil)
+			}
+		})
+	}
+}
+
+// TestRetryAfterARefusedDecodeStillSeesTheRewrite is the other half of dropping
+// the buffer on failure: the check that follows has nothing to compare against,
+// and must fall back to the digest comparison rather than passing for lack of a
+// reference.
+func TestRetryAfterARefusedDecodeStillSeesTheRewrite(t *testing.T) {
+	eng, root, dir, _ := predicateFixture(t)
+	r := deferredSession(t, eng, root, dir)
+	original := stateBytes(t, dir)
+	editInPlaceSameLength(t, dir)
+
+	if err := r.materializeDeferred(&WorkCounters{}); err == nil {
+		t.Fatal("the first decode accepted a rewritten state")
+	}
+	if r.deferred.bytes != nil {
+		t.Fatal("the failed decode kept its stale buffer")
+	}
+
+	err := r.materializeDeferred(&WorkCounters{})
+	if !errors.Is(err, ErrInputsChanged) {
+		t.Fatalf("retry without a retained buffer: err = %v, want ErrInputsChanged", err)
+	}
+
+	// And the fallback is a real comparison, not a refusal of everything: put the
+	// bytes back and the same call has to succeed, or the buffer being absent
+	// would mean the deferral could never be resolved.
+	if err := os.WriteFile(statePath(dir), original, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	var work WorkCounters
+	if err := r.materializeDeferred(&work); err != nil {
+		t.Fatalf("restored state was refused by the fallback: %v", err)
+	}
+	if r.state == nil || r.deferred != nil {
+		t.Fatal("the fallback decode did not resolve the deferral")
+	}
+	if work.StateDecodes != 1 {
+		t.Fatalf("fallback decodes = %d, want 1", work.StateDecodes)
+	}
+	// The fallback is the original path, so it pays the digest the retained
+	// comparison avoids. That it costs one is the point of recording it.
+	if work.StateFingerprints != 1 {
+		t.Fatalf("fallback fingerprints = %d, want the one it reads for", work.StateFingerprints)
+	}
+}
+
+// TestAdmittedProofReleasesTheBytesAndTheNextRefusalStillDecodes is the ordinary
+// two-transaction life of a resident: a no-op answers from the proof and has no
+// use for the bytes, and a later transaction over a moved tree still has to
+// produce the same state a first-transaction refusal would.
+func TestAdmittedProofReleasesTheBytesAndTheNextRefusalStillDecodes(t *testing.T) {
+	eng, root, dir, st := predicateFixture(t)
+	r := deferredSession(t, eng, root, dir)
+
+	res, work, err := r.transaction(context.Background(), nil, false)
+	if err != nil {
+		t.Fatalf("no-op transaction: %v", err)
+	}
+	if work.ProofRefusal != "" {
+		t.Fatalf("unchanged tree was refused: %s", work.ProofRefusal)
+	}
+	if res.TargetGeneration != st.Generation {
+		t.Fatalf("the no-op moved the generation to %d", res.TargetGeneration)
+	}
+	if r.deferred == nil {
+		t.Fatal("the admitted proof resolved the deferral, so the resident has no state and no deferral")
+	}
+	if r.deferred.bytes != nil {
+		t.Fatal("an admitted proof never decodes, but the bytes it did not decode are still held")
+	}
+
+	if err := os.WriteFile(filepath.Join(root, "src/leaf.ts"),
+		[]byte("import {base} from './base';\nexport const leaf=base+2;\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	res2, work2, err := r.transaction(context.Background(), nil, false)
+	if err != nil {
+		t.Fatalf("second transaction after the edit: %v", err)
+	}
+	if work2.ProofRefusal == "" {
+		t.Fatal("an edited tree was admitted")
+	}
+	if work2.StateDecodes != 1 {
+		t.Fatalf("decodes = %d, want the one the fallback needs", work2.StateDecodes)
+	}
+	if res2.ParsedFiles == 0 {
+		t.Fatalf("the fallback parsed nothing after an edit: %+v", res2)
+	}
+	if r.state == nil || r.deferred != nil {
+		t.Fatal("the refusal did not resolve the deferral")
+	}
+}
