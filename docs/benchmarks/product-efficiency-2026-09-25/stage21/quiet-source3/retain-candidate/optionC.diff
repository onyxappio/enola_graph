+// committedRecheck is what a re-read of the committed state found relative to
+// the bytes a proof was bound to.
+type committedRecheck int
+
+const (
+	// committedSame means the file still holds exactly the retained bytes.
+	committedSame committedRecheck = iota
+	// committedRemoved means the file is gone.
+	committedRemoved
+	// committedRewritten means the file exists and holds different bytes.
+	committedRewritten
+)
+
+// recheckCommitted re-reads the committed state and compares it with the bytes
+// the proof was bound to, byte for byte.
+//
+// This is the rewrite detection materializeDeferred used to get by digesting
+// the file a second time and comparing fingerprints. Comparing the bytes
+// themselves is the same check without the second SHA-256: it catches every
+// rewrite a digest comparison catches, including an in-place edit of the same
+// length that restored the timestamps, and it needs no argument about
+// collisions. The read is not avoided - the file is read again, because a check
+// that does not look at the file cannot see a writer that ignored the lock.
+//
+// Both buffers are live while bytes.Equal runs: comparing two readings of a file
+// means holding two readings of it, and the peak here is the size of the state
+// twice over. What the locality buys is the other side of that - the comparison
+// buffer is unreferenced once this returns, so it is not still held across the
+// caller's decode, where the retained buffer and the typed state are both alive.
+// Unreferenced is not reclaimed; when the collector actually frees it is its own
+// business, and the peak is measured rather than asserted here.
+func recheckCommitted(path string, retained []byte) (committedRecheck, error) {
+	tRead := time.Now()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return committedRemoved, nil
+		}
+		return committedRewritten, err
+	}
+	graphprofile.Since("state_read_bytes", tRead, fmt.Sprintf("%s bytes=%d", filepath.Base(path), len(b)))
+	tCmp := time.Now()
+	same := bytes.Equal(b, retained)
+	graphprofile.Since("state_bytes_compared", tCmp, fmt.Sprintf("bytes=%d same=%v", len(b), same))
+	if !same {
+		return committedRewritten, nil
+	}
+	return committedSame, nil
 }
 
