+// A file importing only external modules can still expose a fully local export
+// surface. Reuse only an already recorded context-free proof, with no repository
+// or framework reads; unknown and cross-file bindings keep the conservative path.
+func sideReadLocalSurface(rec *tsextractor.FileRecord) bool {
+	if passesNoBinding(rec) {
+		return true
+	}
+	return replayableDependent(rec) && rec.ExportSurfaceRecorded && rec.ExportSurfaceContextFree &&
+		len(rec.ResolvedFiles) == 0 && len(rec.UnresolvedSpecs) == 0 &&
+		len(rec.Reexports) == 0 && len(rec.SideReads) == 0 && len(rec.SideReadHashes) == 0
+}
