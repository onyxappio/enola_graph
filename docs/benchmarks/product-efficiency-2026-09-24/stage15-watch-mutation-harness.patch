+def product_mutation(repo, spec_path):
+    raw = Path(spec_path).read_bytes()
+    spec = json.loads(raw)
+    rel = Path(spec["path"])
+    if rel.is_absolute() or ".." in rel.parts:
+        raise ValueError("mutation path must stay inside Product")
+    path = (repo / rel).resolve()
+    path.relative_to(repo.resolve())
+    original = path.read_text()
+    if hashlib.sha256(path.read_bytes()).hexdigest() != spec["original_sha256"]:
+        raise ValueError("mutation source hash mismatch")
+    variants = []
+    for replacement in spec["variants"]:
+        before, after = replacement["before"], replacement["after"]
+        if not before or original.count(before) != 1 or before == after:
+            raise ValueError("mutation must replace exactly one unique snippet")
+        variants.append(original.replace(before, after, 1))
+    if not variants:
+        raise ValueError("mutation needs at least one edit")
+    return path, original, variants, hashlib.sha256(raw).hexdigest()
 
 
